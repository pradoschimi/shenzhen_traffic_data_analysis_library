# ===================================================
# 环境变量模板
# 复制本文件为 .env 并填入实际值
# ===================================================

# ----- 深圳开放数据平台 API -----
SZ_OPENDATA_APP_KEY=your_app_key_here

# ----- MySQL 数据库 -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sz_traffic
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=sz_traffic_db
MYSQL_ROOT_PASSWORD=your_root_password_here

# ----- Redis (可选) -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----- JWT 认证 -----
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- 应用配置 -----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ----- 时区 -----
TZ=Asia/Shanghai
